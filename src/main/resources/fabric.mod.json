{
  "schemaVersion": 1,
  "id": "player_speed",
  "version": "${version}",
  "name": "Player Speed",
  "description": "A lightweight, zero-dependency mod adding a real-time player speed overlay to the vanilla F3 debug screen, backporting the official 26.3 player_speed entry structure.",
  "authors": [
    "Dasik (Rifaditya)"
  ],
  "contact": {
    "homepage": "https://github.com/Rifaditya/player-speed"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/player_speed/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vanillaoutsider.playerspeed.client.PlayerSpeedClient"
    ]
  },
  "mixins": [
    "player-speed.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=26.2"
  }
}
